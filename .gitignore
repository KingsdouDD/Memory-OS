# =======================
# Runtime Data (Private)
# =======================

# Neo4j data — binary DB files, auto-generated by Neo4j service
neo4j/*.db
neo4j/**/*.db
neo4j/*.pl
neo4j/**/*~

# Qdrant storage — vector data, auto-generated by Qdrant service
qdrant/storage/
qdrant/*.db
qdrant/**/*.db

# Models — downloaded at runtime, large binary files
models/**/*.bin
models/**/*.safetensors
models/**/*.gguf
models/**/*.pt
models/**/*.pth
models/**/model.safetensors*

# Tokens / secrets
tokens/*.json
tokens/*.yaml
tokens/*.yml
tokens/*.env
tokens/*.txt
tokens/*.key

# Logs
logs/*.log
logs/**/*.log

# Python venv
venv/
.venv/

# DS_Store
.DS_Store
**/.DS_Store

# Byte-compiled
__pycache__/
*.py[cod]
*.pyc

# IDE
.idea/
.vscode/
*.swp
*.swo

# Temp
*.tmp
*.temp
*.bak

# =======================
# Keep These (Public)
# =======================
# Keep these directories as empty placeholders:
!logs/.gitkeep
!tokens/.gitkeep
!models/.gitkeep

