# =======================
# Runtime Data (Private)
# =======================

# Neo4j data — binary DB files, auto-generated by Neo4j service
neo4j/*.db
neo4j/**/*.db
neo4j/*.pl
neo4j/**/*~

# Qdrant storage — vector data, auto-generated by Qdrant service
qdrant/storage/
qdrant/*.db
qdrant/**/*.db
qdrant/data/
qdrant/logs/
data/

# Models — downloaded at runtime, large binary files
models/
models/**/*.bin
models/**/*.safetensors
models/**/*.gguf
models/**/*.pt
models/**/*.pth
models/**/model.safetensors*
models/**/*.bpe.model
models/**/*.json

# Tokens / secrets
tokens/*.json
tokens/*.yaml
tokens/*.yml
tokens/*.env
tokens/*.txt
tokens/*.key

# Logs — including .md hooks/decisions traces
logs/
logs/*.log
logs/**/*.log
logs/*.md
logs/**/*.md

# Runtime State Timer — 临时状态（个人对话上下文）
memory-os-plugin/runtime_active_state/
memory-os-plugin/runtime_active_state/*

# Snapshots — 备份快照可能含用户数据
snapshots/

# Python venv
venv/
.venv/

# Test artifacts — 临时测试文件
/tmp/mcp_client_test.py
/tmp/mcp_e2e_test.py

# DS_Store
.DS_Store
**/.DS_Store

# Byte-compiled
__pycache__/
*.py[cod]
*.pyc

# IDE
.idea/
.vscode/
*.swp
*.swo

# Temp
*.tmp
*.temp
*.bak

# OpenClaw workspace runtime
memory/
memory-os/

# =======================
# Keep These (Public)
# =======================
# Keep these directories as empty placeholders:
!logs/.gitkeep
!tokens/.gitkeep
!models/.gitkeep
!neo4j/.gitkeep
!qdrant/.gitkeep

